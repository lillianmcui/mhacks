# Copy to .env (never commit .env). Read by services/core-api and services/seed.
# Web-app variables live in apps/web/.env.example; agent variables in
# agents/fetch/.env.example and agents/relay/.env.example.

# --- Core API ---------------------------------------------------------------
# Shared bearer token for POST /actions/*. Required. Generate one with:
#   openssl rand -hex 32
CORE_API_TOKEN=
CORE_API_HOST=127.0.0.1
CORE_API_PORT=8787
# live: SpacetimeDB-backed. stub: in-memory, invented sample data, sends nothing.
CORE_API_MODE=live
# Origin allowed to call the API from a browser (the dashboard).
CORS_ORIGIN=*

# --- SpacetimeDB ------------------------------------------------------------
# Local: ws://127.0.0.1:3000   Cloud: wss://maincloud.spacetimedb.com
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DATABASE=ch4se
# Optional identity token for the Core API's connection.
SPACETIMEDB_TOKEN=

# --- Seed / replay ----------------------------------------------------------
# Track C's fixtures, relative to the repo root.
FIXTURES_DIR=data/fixtures
# Asset-matching radius R in metres.
MATCH_RADIUS_M=250

# --- Track C adapters (read inside the Core API process only) ----------------
# Set to false to force the fallback paths: TEMPLATE briefings / UPSTREAM_UNAVAILABLE.
GROK_ENABLED=true
RELAY_ENABLED=true
GROK_API_KEY=
GROK_MODEL=grok-3
RELAY_API_KEY=
# Base URL of the Relay API, no trailing path.
RELAY_API_BASE=https://api.relayapp.im

# Relay recipient handle (defaults to agent owner from GET /v1/me)
# RELAY_NOTIFY_HANDLE=bennett
# RELAY_FROM_HANDLE=
