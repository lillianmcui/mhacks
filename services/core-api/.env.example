# NOTE: The Core API process loads only the **repo-root** `.env`
# (see root `.env.example` after the backend branch merges).
# Do NOT put secrets here — keys in `services/core-api/.env` are ignored.
#
# Required for Track C adapters (root `.env`):
#   GROK_ENABLED, GROK_API_KEY, GROK_MODEL
#   RELAY_ENABLED, RELAY_API_KEY, RELAY_API_BASE
#   optional: RELAY_SMS_PATH, RELAY_CALL_PATH
#   CORE_API_TOKEN
