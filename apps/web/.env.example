# Where table rows come from: "mock" (in-browser fake backend) or "live" (SpacetimeDB).
VITE_DATA_SOURCE=mock
# Where action calls go: "mock" (in-browser fake backend) or "http" (Core API).
# Use mock+mock before CP0, live+http from CP0 on. Don't mix mock data with http actions.
VITE_CORE_API=mock

# SpacetimeDB (live mode)
VITE_STDB_URI=ws://localhost:3000
VITE_STDB_MODULE=ch4se

# Core API (http mode)
VITE_CORE_API_URL=http://localhost:8787
# Shared bearer token. NOTE: anything prefixed VITE_ ships to the browser bundle.
VITE_CORE_API_TOKEN=

# Basemap. Leave blank for the default keyless Esri satellite raster; set VITE_MAP_OFFLINE=1 for a
# plain background (no network needed) on the demo laptop.
VITE_MAP_STYLE_URL=
VITE_MAP_OFFLINE=0
